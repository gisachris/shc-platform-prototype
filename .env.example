# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# Gemini (optional — enables CFP AI review)
GEMINI_API_KEY=

# LiveKit WebRTC (required for virtual sessions)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase — use the HTTPS project URL, NOT the postgres:// connection string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend (Vite) — same HTTPS URL + anon key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# EmailJS (optional — welcome + password-reset emails)
# Prefer server-side vars; VITE_ copies work for local if shared with the API process.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_ID_WELCOME=
EMAILJS_TEMPLATE_ID_RESET=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_WELCOME=
VITE_EMAILJS_TEMPLATE_ID_RESET=
VITE_EMAILJS_PUBLIC_KEY=
